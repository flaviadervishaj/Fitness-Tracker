# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_tracker
SECRET_KEY=replace-with-a-long-random-string

# Optional: enable password recovery after verifying a sending domain with Resend.
# RESEND_API_KEY=re_...
# RESET_EMAIL_FROM=Fitness Tracker <hello@your-domain.com>
# FRONTEND_URL=https://your-frontend.example.com

# Example for different database setups:
# DATABASE_URL=postgresql://username:password@localhost:5432/fitness_tracker
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
